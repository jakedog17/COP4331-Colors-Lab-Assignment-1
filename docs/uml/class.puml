@startuml
title Colors App - Class Diagram
skinparam classAttributeIconSize 0

class BrowserClient <<JavaScript code.js>> {
  -userId: int
  -firstName: string
  -lastName: string
  +doLogin()
  +saveCookie()
  +readCookie()
  +doLogout()
  +searchColor()
  +addColor()
}

class Users <<MySQL table>> {
  +ID: int
  +Login: string
  -Password: string
  +firstName: string
  +lastName: string
}

class Colors <<MySQL table>> {
  +Name: string
  +UserId: int
}

class LoginEndpoint <<API/Login.php>> {
  +login(login, password)
}

class SearchColorsEndpoint <<API/SearchColors.php>> {
  +searchColors(search, userId)
}

class AddColorEndpoint <<API/AddColor.php>> {
  +addColor(color, userId)
}

BrowserClient ..> LoginEndpoint : sends login request
BrowserClient ..> SearchColorsEndpoint : sends search request
BrowserClient ..> AddColorEndpoint : sends add request

LoginEndpoint ..> Users : queries credentials
SearchColorsEndpoint ..> Colors : queries by name and userId
AddColorEndpoint ..> Colors : inserts name and userId
Users "1" -- "0..*" Colors : userId association

@enduml
