@startuml
title Colors App - LAMP Activity Flow

|User|
start
:Open index.html;
:Enter username and password;
:Click "Do It";

repeat
  |Browser|
  :doLogin() builds JSON credentials;
  :Send POST request to Login.php;

  |PHP API|
  :Read JSON request;
  :Open database connection;
  |MySQL Database|
  :Receive connection;
  |PHP API|
  if (Database connection succeeds?) then (yes)
    |MySQL Database|
    :Find user by login and password in Users;
    |PHP API|
    if (Matching user found?) then (yes)
      :Return JSON with id, firstName, lastName;
    else (no)
      :Return JSON with id 0 and error;
    endif
  else (no)
    :Return database connection error;
  endif

  |Browser|
  :Parse login response;
  if (Returned id is greater than 0?) then (yes)
    :saveCookie() stores user data for 20 minutes;
    :Redirect to color.html;
  else (no)
    :Display login error on index.html;
  endif
repeat while (Login failed?) is (yes)

|Browser|
:color.html calls readCookie() to check userId;
:Redirect to index.html if userId is less than 0;
:Show color-management page when the session is valid;

|User|
repeat
  :Choose a button on color.html;
  if (Search Color button clicked?) then (yes)
    :Enter search text and click Search Color;

    |Browser|
    :searchColor() builds JSON with search and userId;
    :Send POST request to SearchColors.php;

    |PHP API|
    :Read JSON request;
    :Open database connection;
    |MySQL Database|
    :Find matching Colors for this user;
    |PHP API|
    if (Matching colors found?) then (yes)
      :Return JSON results;
    else (no)
      :Return no-records error;
    endif

    |Browser|
    :Display returned color names or search result;
  else (no)
    if (Add Color button clicked?) then (yes)
      |User|
      :Enter color name and click Add Color;

      |Browser|
      :addColor() builds JSON with color and userId;
      :Send POST request to AddColor.php;

      |PHP API|
      :Read JSON request;
      :Open database connection;
      |MySQL Database|
      :Insert color name and userId into Colors;
      |PHP API|
      :Return JSON response;

      |Browser|
      :Display color-added message;
    else (Log Out button)
      |Browser|
      :Handle the Log Out button click;
      :doLogout() clears client state and cookie;
      :Redirect to index.html;
    endif
  endif
repeat while (Session remains active?) is (yes)

stop
@enduml
